#!/usr/bin/env bash
# Dependency-free ANSI color swatch for the rvim startup dashboard.
# Replacement for `colorscript -e square` (not available on every system).
# Prints exactly 3 rows of 59 cells to match the dashboard terminal height.

set -u

cells=59
palette=(
  "#002b36" "#073642" "#586e75" "#657b83"
  "#839496" "#93a1a1" "#eee8d5" "#fdf6e3"
  "#b58900" "#cb4b16" "#dc322f" "#d33682"
  "#6c71c4" "#268bd2" "#2aa198" "#859900"
)

row() {
  local offset=$1 i hex
  for ((i = 0; i < cells; i++)); do
    hex=${palette[$(((offset + i) % ${#palette[@]}))]}
    printf '\033[48;2;%d;%d;%dm \033[0m' \
      "$((16#${hex:1:2}))" "$((16#${hex:3:2}))" "$((16#${hex:5:2}))"
  done
  printf '\n'
}

row 1
row 9
row 5
